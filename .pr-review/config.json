{
  "version": 1,
  "project": "software-dev-team",
  "visibility": "public",
  "securityChannel": "advisory",
  "workflowPath": ".github/workflows/pr-review.yml",
  "learnWorkflowPath": ".github/workflows/pr-review-learn.yml",
  "packages": [
    "src",
    "plugin",
    "docs",
    ".pr-review",
    ".github"
  ],
  "knowledge": [
    "checklist.md",
    "contract-map.md",
    "conventions.md",
    "false-positives.md",
    "learned-lessons.md"
  ],
  "classes": [
    {
      "id": 1,
      "name": "Alternate shell spelling slips past a deny rule",
      "security": true,
      "protected": true
    },
    {
      "id": 2,
      "name": "A carve-out in a deny check opens a hole",
      "security": true,
      "protected": true
    },
    {
      "id": 3,
      "name": "Path confinement and resolution",
      "security": true,
      "protected": true
    },
    {
      "id": 4,
      "name": "Fail-open on unexpected input",
      "security": true,
      "protected": true
    },
    {
      "id": 5,
      "name": "One rule family updated in one tool but not the others",
      "security": true,
      "protected": true
    },
    {
      "id": 6,
      "name": "Evidence or outcome reported as better than it was"
    },
    {
      "id": 7,
      "name": "Prompt, help text or comment claims what the harness does not enforce"
    },
    {
      "id": 8,
      "name": "Silent misconfiguration accepted"
    },
    {
      "id": 9,
      "name": "SDK behaviour assumed, not verified"
    },
    {
      "id": 10,
      "name": "Over-blocking, or a loosening nobody called out"
    },
    {
      "id": 11,
      "name": "PR text claims what the code or the merge does not do",
      "always": true,
      "light": true
    },
    {
      "id": 12,
      "name": "A test that cannot catch the regression"
    }
  ],
  "tiers": {
    "maxTurns": {
      "full": 60,
      "incremental-new-links": 45,
      "incremental": 25,
      "light": 10,
      "base-drift": 10
    }
  },
  "lightFiles": [
    "docs/**",
    "**/*.txt",
    "**/*.png",
    "**/*.svg",
    "pnpm-lock.yaml"
  ],
  "largePr": {
    "files": 60,
    "lines": 6000
  },
  "inline": {
    "max": 5,
    "severities": [
      "Critical",
      "High"
    ]
  },
  "checks": {
    "secrets": true,
    "piiLogs": false,
    "newFileSize": false,
    "titleScope": false,
    "selfEdit": true,
    "verifyDiff": false,
    "project": [
      "checks/policy.mjs",
      "checks/contracts.mjs"
    ],
    "writeCollaborators": {
      "allowed": [
        "repository-owner"
      ]
    }
  },
  "trust": {
    "contextAssociations": [
      "OWNER"
    ],
    "feedbackAuthors": [
      "repository-owner"
    ]
  },
  "learning": {
    "distill": "model",
    "commands": {
      "format": [
        "npx --yes prettier@3.9.10 --write {files}"
      ],
      "validate": [
        "node --test '.pr-review/checks/test/*.test.mjs'"
      ]
    }
  },
  "lightExclude": [
    "src/**/prompt.md",
    "plugin/**"
  ],
  "secrets": {
    "allowPatterns": [
      "^sk-ant-test-[0-9a-f]{8,32}$"
    ]
  }
}
